# 영상 QA 프로젝트 설정. 엔진(scripts/run.sh)이 zsh로 source한다. 앱에 관한 것은 전부 여기(와 states.sh, flows.sh)에 둔다.
# 경로는 앱 레포 루트 기준. 값을 고친 뒤 `qa doctor`로 확인한다.

# ── 빌드 ── (둘 중 하나: QA_PROJECT 또는 QA_WORKSPACE)
QA_PROJECT="__PROJECT__"                 # 예: "<폴더>/<이름>.xcodeproj"
QA_WORKSPACE="__WORKSPACE__"             # 예: "<폴더>/<이름>.xcworkspace"(의존성 관리 도구가 만든 것 등)
QA_SCHEME="__SCHEME__"
QA_APP_NAME=""                           # 빌드 결과물 .app 이름(확장자 없이). 비우면 스킴 이름, 그것도 없으면 유일한 .app
QA_CONFIGURATION=Debug
QA_BUNDLE_ID=""                          # 비우면 빌드 결과물의 Info.plist에서 읽는다
QA_REQUIRED_FILES=()                     # 빌드 전에 있어야 하는 파일(레포에 커밋하지 않는 로컬 설정 등). 값은 읽지 않는다

# ── 실행 ──
QA_INPUT_LANG=ko                         # 화면 키보드 자판 팩: scripts/lib/keyboard/<언어>.py (references/keyboard-packs.md)
QA_STATUS_BAR_TIME="9:41"
QA_LAUNCH_ARGS=()                        # 앱이 지원하는 실행 인자(날짜 고정 등). 앱이 지원할 때만

# 조건 이름 → "기기 이름[;글씨 크기]". 각본의 '조건:'에 쓰는 이름과 같아야 한다. 기기는 이 Mac에 있는 시뮬레이터 이름
QA_CONDITIONS=(
  "기본"      "__DEVICE__"
  # "작은 기기" "<작은 화면 시뮬레이터 이름>"
  # "큰 글씨"   "__DEVICE__;accessibility-large"
)

# ── 정해야 하는 값(비우면 기본값) ──
# QA_DAY_BOUNDARY_HOUR=                  # 앱의 하루가 자정이 아닌 시각(시)에 바뀌면. 그 전에 돌리면 경고한다
# QA_KEEP_RUNS=10                        # 결과 보존: 최근 N회
# QA_KEEP_DAYS=14                        #            또는 D일 이내
# QA_UNVERIFIABLE_CASE_MAX=30            # 재현 검증의 검증 불가 비율 상한(%, 각본별). 넘으면 실행을 통과로 보지 않는다
# QA_UNVERIFIABLE_RUN_MAX=20             #                                  (%, 실행 전체)
